<Window x:Class="pr6_Trefilova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:pr6_Trefilova"
        mc:Ignorable="d"
        Title="Управление роботами" Height="500" Width="600"
        Background="{DynamicResource MainBackground}"
        Foreground="{DynamicResource MainForeground}">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <GroupBox Header="Режим работы" Grid.Row="0" Margin="5">
            <StackPanel Margin="5">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <RadioButton Content="Автоматический" Margin="0,0,15,0" IsChecked="True"/>
                    <RadioButton Content="Ручной" Margin="0,0,15,0"/>
                    <RadioButton Content="Наладка"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <CheckBox Content="Камера" Margin="0,0,15,0"/>
                    <CheckBox Content="Освещение" Margin="0,0,15,0"/>
                    <CheckBox Content="Щетки"/>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Выбор робота" Grid.Row="1" Margin="5" Foreground="{DynamicResource MainForeground}">
            <StackPanel Margin="5">
                <ComboBox SelectedIndex="0" Margin="0,0,0,5">
                    <ComboBoxItem Content="Робот-Манипулятор"/>
                    <ComboBoxItem Content="Робот-Погрузчик"/>
                    <ComboBoxItem Content="Робот-Сварщик"/>
                </ComboBox>
            </StackPanel>
        </GroupBox>

        <GroupBox Header="Управление" Grid.Row="2" Margin="5" Foreground="{DynamicResource MainForeground}">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,0,0,10">
                    <Button Content="Запустить" Margin="5" Width="100"/>
                    <Button Content="Приостановить" Margin="5" Width="100"/>
                    <Button Content="Сменить тему" Margin="5" Width="120" Click="ChangeThemeButton_Click"/>
                </StackPanel>

                <ProgressBar Grid.Row="1" Margin="5" Minimum="0" Maximum="100" Value="50"/>

                <TextBox Grid.Row="2" Height="25" Margin="5"
                         Text="Однострочное поле ввода">
                </TextBox>
                
                <TextBox Grid.Row="3" Height="70" Margin="5" 
                         VerticalScrollBarVisibility="Auto"
                         AcceptsReturn="True"
                         Text="Система готова к работе... &#10;Многострочное поле ввода."/>
            </Grid>
        </GroupBox>

        <Button Grid.Row="3" Content="АВАРИЙНАЯ ОСТАНОВКА" 
                Style="{StaticResource DangerButtonStyle}" 
                Height="50" FontSize="16"/>
    </Grid>
</Window>
