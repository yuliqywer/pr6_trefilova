<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ButtonBackground" Color="#333333"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#444444"/>
        <SolidColorBrush x:Key="ButtonPressed" Color="#222222"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="ButtonBorder" Color="#555555"/>

        <SolidColorBrush x:Key="MainBackground" Color="#1E1E1E"/>
        <SolidColorBrush x:Key="MainForeground" Color="#FFFFFF"/>

        <SolidColorBrush x:Key="DangerBackground" Color="#CC0000"/>
        <SolidColorBrush x:Key="DangerHover" Color="#EE3333"/>
        <SolidColorBrush x:Key="DangerPressed" Color="#990000"/>
    <SolidColorBrush x:Key="DangerForeground" Color="#FFFFFF"/>
</ResourceDictionary>