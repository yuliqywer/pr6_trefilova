<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="ButtonBackground" Color="#E0E0E0"/>
        <SolidColorBrush x:Key="ButtonHover" Color="#D0D0D0"/>
        <SolidColorBrush x:Key="ButtonPressed" Color="#B0B0B0"/>
        <SolidColorBrush x:Key="ButtonForeground" Color="#000000"/>
        <SolidColorBrush x:Key="ButtonBorder" Color="#808080"/>

        <SolidColorBrush x:Key="MainBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="MainForeground" Color="#000000"/>

        <SolidColorBrush x:Key="DangerBackground" Color="#FF4444"/>
        <SolidColorBrush x:Key="DangerHover" Color="#FF6666"/>
        <SolidColorBrush x:Key="DangerPressed" Color="#CC0000"/>
    <SolidColorBrush x:Key="DangerForeground" Color="#FFFFFF"/>
</ResourceDictionary>